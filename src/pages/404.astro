---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizePath, useTranslations } from '../i18n/utils';

const en = useTranslations('en');
const tr = useTranslations('tr');
---

<BaseLayout lang="en" title="404">
  <section class="container not-found">
    <div class="hole" aria-hidden="true"></div>
    <span class="eyebrow">404</span>
    <h1>{en('404.title')}</h1>
    <p>{en('404.text')}</p>
    <p class="alt" lang="tr">{tr('404.title')} — {tr('404.text')}</p>
    <div class="actions">
      <a class="btn btn-primary" href={localizePath('/', 'en')}>{en('404.back')}</a>
      <a class="btn" href={localizePath('/', 'tr')} lang="tr">{tr('404.back')}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-top: var(--header-h);
    padding-bottom: 64px;
  }

  .hole {
    width: 140px;
    height: 140px;
    margin-bottom: 36px;
    border-radius: 50%;
    background: #000;
    box-shadow:
      0 0 0 2px rgba(255, 220, 180, 0.8),
      0 0 30px 6px rgba(255, 140, 60, 0.55),
      0 0 120px 30px rgba(255, 110, 40, 0.18);
  }

  h1 {
    margin-top: 12px;
    font-size: clamp(2rem, 5vw, 3.25rem);
    max-width: 18ch;
  }

  p {
    margin-top: 16px;
    max-width: 52ch;
    color: var(--text-muted);
  }

  .alt {
    font-size: 0.9rem;
    color: var(--text-dim);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }
</style>
