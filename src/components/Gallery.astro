---
interface Props {
  images: string[];
  title: string;
  closeLabel: string;
}
const { images, title, closeLabel } = Astro.props;
---

<div class="gallery" data-gallery>
  <ul>
    {
      images.map((src, i) => (
        <li>
          <a href={src} data-index={i} aria-label={`${title} — ${i + 1}/${images.length}`}>
            <img src={src} alt="" loading="lazy" decoding="async" width="1920" height="1080" />
          </a>
        </li>
      ))
    }
  </ul>

  <dialog aria-label={title}>
    <img alt="" />
    <button type="button" class="close" data-close aria-label={closeLabel}>×</button>
    <button type="button" class="nav prev" data-step="-1" aria-label="Previous">‹</button>
    <button type="button" class="nav next" data-step="1" aria-label="Next">›</button>
  </dialog>
</div>

<style>
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 14px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  a img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }

  a:hover img {
    transform: scale(1.04);
  }

  dialog {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(0, 0, 0, 0.92);
  }

  dialog::backdrop {
    background: transparent;
  }

  dialog[open] {
    display: grid;
    place-items: center;
  }

  dialog img {
    max-width: min(94vw, 1600px);
    max-height: 86dvh;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  dialog button {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: rgba(16, 20, 30, 0.8);
    color: var(--text);
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
  }

  .close {
    top: 16px;
    right: 16px;
  }

  .nav {
    top: 50%;
    translate: 0 -50%;
  }

  .prev {
    left: 16px;
  }

  .next {
    right: 16px;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const dialog = root.querySelector('dialog')!;
    const big = dialog.querySelector('img')!;
    const links = [...root.querySelectorAll<HTMLAnchorElement>('a[data-index]')];
    let index = 0;

    const show = (i: number) => {
      index = (i + links.length) % links.length;
      big.src = links[index].href;
    };

    links.forEach((link, i) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );

    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((btn) =>
      btn.addEventListener('click', () => show(index + Number(btn.dataset.step))),
    );
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });
  });
</script>
