---
// Hafif YouTube oynatıcı: tıklanana kadar sadece küçük resim yüklenir (sayfa hızlı açılır).
interface Props {
  id: string;
  title: string;
  label: string;
}
const { id, title, label } = Astro.props;
---

<div class="trailer" data-trailer={id} data-title={title}>
  <button type="button" aria-label={`${label}: ${title}`}>
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" />
    <span class="play" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"></path></svg>
    </span>
  </button>
</div>

<style>
  .trailer {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: #000;
    border: 1px solid var(--border);
  }

  button {
    all: unset;
    position: absolute;
    inset: 0;
    cursor: pointer;
  }

  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
    transition: opacity 0.3s;
  }

  button:hover img {
    opacity: 1;
  }

  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 84px;
    height: 84px;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--accent);
    color: #120800;
    box-shadow: 0 0 0 10px rgba(255, 138, 61, 0.2), 0 0 48px var(--accent-glow);
    transition: transform 0.25s;
  }

  .play svg {
    width: 34px;
    margin-left: 4px;
  }

  button:hover .play {
    transform: scale(1.06);
  }

  .trailer :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-trailer]').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.trailer}?autoplay=1&rel=0`;
      iframe.title = el.dataset.title ?? 'Trailer';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
    });
  });
</script>
