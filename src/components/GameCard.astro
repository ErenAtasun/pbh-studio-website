---
import type { Game } from '../data/games';
import type { Lang } from '../i18n/ui';
import { localizePath, useTranslations } from '../i18n/utils';

interface Props {
  game: Game;
  lang: Lang;
}
const { game, lang } = Astro.props;
const t = useTranslations(lang);
const { title, tagline, cover, status, genres, platforms, releaseDate } = game.data;
---

<article class="game-card">
  <a href={localizePath(`/games/${game.slug}`, lang)}>
    <div class="cover">
      <img src={cover} alt="" loading="lazy" decoding="async" width="1920" height="1080" />
    </div>
    <div class="body">
      <div class="meta">
        <span class="badge" data-status={status}>{t(`status.${status}` as const)}</span>
        {releaseDate && <span class="date">{releaseDate}</span>}
      </div>
      <h3>{title}</h3>
      <p>{tagline}</p>
      <ul class="chips">
        {[...genres, ...platforms].map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </a>
</article>

<style>
  .game-card a {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      border-color 0.25s,
      transform 0.25s,
      box-shadow 0.25s;
  }

  .game-card a:hover {
    border-color: rgba(255, 138, 61, 0.45);
    transform: translateY(-4px);
    box-shadow: 0 18px 48px -20px var(--accent-glow);
  }

  .cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface-2);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }

  .game-card a:hover .cover img {
    transform: scale(1.04);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 22px 24px;
    flex: 1;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .date {
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  h3 {
    font-size: 1.4rem;
  }

  p {
    color: var(--text-muted);
    font-size: 0.95rem;
    flex: 1;
  }
</style>
