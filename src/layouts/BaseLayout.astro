---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { studio } from '../data/studio';
import { languages, type Lang } from '../i18n/ui';
import { localizePath, stripLang, useTranslations, withBase } from '../i18n/utils';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
}

const { lang, title, description, image = withBase('/og-default.jpg') } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ? `${title} — ${studio.name}` : `${studio.name} — ${studio.fullName}`;
const pageDescription = description ?? t('site.description');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const basePath = stripLang(Astro.url.pathname);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {
      (Object.keys(languages) as Lang[]).map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(localizePath(basePath, l), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localizePath(basePath, 'en'), Astro.site)} />

    <link rel="icon" href={withBase('/favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#05060a" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={studio.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@125,700&family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    padding: 10px 16px;
    background: var(--accent);
    color: #000;
    border-radius: 8px;
    text-decoration: none;
  }
  .skip-link:focus {
    top: 16px;
  }
</style>
