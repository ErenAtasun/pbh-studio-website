---
import BaseLayout from '../layouts/BaseLayout.astro';
import * as aboutEn from '../copy/about.en.md';
import * as aboutTr from '../copy/about.tr.md';
import { studio, activeSocials } from '../data/studio';
import { getGames } from '../data/games';
import type { Lang } from '../i18n/ui';
import { localizePath, pick, useTranslations, withBase } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const about = lang === 'tr' ? aboutTr : aboutEn;
const games = await getGames(lang);
const website = Astro.site?.host ?? '';

// Basın materyalleri: dosyaları public/press/ klasörüne koy ve buraya ekle.
// light: koyu zemin için (beyaz logo), dark: açık zemin için (siyah logo)
const assets = [
  { label: 'Logo — light (PNG)', file: withBase('/press/pbh-logo-light.png'), bg: 'dark' },
  { label: 'Logo — dark (PNG)', file: withBase('/press/pbh-logo-dark.png'), bg: 'light' },
  { label: 'Mark — light (PNG)', file: withBase('/press/pbh-mark-light.png'), bg: 'dark' },
  ...games.map((g) => ({ label: `${g.data.title} — key art`, file: g.data.cover, bg: 'cover' })),
];
---

<BaseLayout lang={lang} title={t('press.title')} description={t('press.intro')}>
  <section class="container page-hero">
    <span class="eyebrow" lang="en">{studio.name}</span>
    <h1>{t('press.title')}</h1>
    <p>{t('press.intro')}</p>
  </section>

  <div class="container layout">
    <aside class="card factsheet">
      <h2 class="eyebrow">{t('press.factsheet')}</h2>
      <dl>
        <div><dt>{t('press.developer')}</dt><dd>{studio.fullName}</dd></div>
        <div><dt>{t('press.basedIn')}</dt><dd>{pick(studio.location, lang)}</dd></div>
        {studio.founded && <div><dt>{t('press.founded')}</dt><dd>{studio.founded}</dd></div>}
        {website && <div><dt>{t('press.website')}</dt><dd>{website}</dd></div>}
        <div>
          <dt>{t('press.contact')}</dt>
          <dd><a href={`mailto:${studio.pressEmail}`}>{studio.pressEmail}</a></dd>
        </div>
        {
          activeSocials.length > 0 && (
            <div>
              <dt>{t('press.social')}</dt>
              <dd class="socials">
                {activeSocials.map((s) => (
                  <a href={s.url} target="_blank" rel="noopener noreferrer">
                    {s.label}
                  </a>
                ))}
              </dd>
            </div>
          )
        }
      </dl>
    </aside>

    <div class="main">
      <section>
        <h2 class="block-title">{t('press.description')}</h2>
        <p class="lead">{about.frontmatter.summary}</p>
      </section>

      {
        games.length > 0 && (
          <section>
            <h2 class="block-title">{t('press.games')}</h2>
            <ul class="games">
              {games.map((g) => (
                <li>
                  <a href={localizePath(`/games/${g.slug}`, lang)}>
                    <img src={g.data.cover} alt="" loading="lazy" width="1920" height="1080" />
                    <span>
                      <strong>{g.data.title}</strong>
                      <small>
                        {t(`status.${g.data.status}` as const)}
                        {g.data.releaseDate && ` · ${g.data.releaseDate}`}
                      </small>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section>
        <h2 class="block-title">{t('press.logos')}</h2>
        <ul class="assets">
          {
            assets.map((a) => (
              <li class="card">
                <div class="preview" data-bg={a.bg}>
                  <img src={a.file} alt="" loading="lazy" />
                </div>
                <div class="asset-row">
                  <span>{a.label}</span>
                  <a href={a.file} download>
                    {t('press.download')} ↓
                  </a>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="card note">
        <p>{t('press.keyRequest')}</p>
        <a class="btn btn-primary" href={`mailto:${studio.pressEmail}`}>{studio.pressEmail}</a>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .layout {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
    padding-bottom: clamp(64px, 10vw, 120px);
  }

  .factsheet {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    padding: 24px;
  }

  dl {
    margin: 12px 0 0;
  }

  dl div {
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
  }

  dl div:last-child {
    border-bottom: 0;
  }

  dt {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  dd {
    margin: 4px 0 0;
    overflow-wrap: anywhere;
  }

  dd a {
    color: var(--accent-soft);
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
  }

  .main {
    display: grid;
    gap: clamp(48px, 6vw, 72px);
  }

  .block-title {
    font-size: clamp(1.4rem, 2.6vw, 1.8rem);
    margin-bottom: 18px;
  }

  .games {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .games a {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 10px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
    text-decoration: none;
  }

  .games a:hover {
    border-color: rgba(255, 138, 61, 0.45);
  }

  .games img {
    width: 160px;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .games span {
    display: grid;
    gap: 2px;
  }

  .games strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
  }

  .games small {
    color: var(--text-muted);
  }

  .assets {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .assets li {
    overflow: hidden;
  }

  .preview {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    background:
      repeating-conic-gradient(rgba(255, 255, 255, 0.03) 0 25%, transparent 0 50%) 0 0 / 20px 20px,
      var(--bg-elev);
  }

  .preview {
    position: relative;
  }

  .preview img {
    position: absolute;
    inset: 10% 15%;
    width: 70%;
    height: 80%;
    object-fit: contain;
  }

  .preview[data-bg='light'] {
    background: #ecebe6;
  }

  .preview[data-bg='cover'] img {
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .asset-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
    font-size: 0.9rem;
  }

  .asset-row a {
    color: var(--accent-soft);
    text-decoration: none;
    white-space: nowrap;
  }

  .note {
    display: grid;
    gap: 20px;
    justify-items: start;
    padding: clamp(24px, 4vw, 40px);
    color: var(--text-muted);
  }

  .note .btn {
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .factsheet {
      position: static;
    }
  }

  @media (max-width: 520px) {
    .games img {
      width: 104px;
    }
  }
</style>
