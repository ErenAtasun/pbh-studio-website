---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlackHole from '../components/BlackHole.astro';
import GameCard from '../components/GameCard.astro';
import { getGames } from '../data/games';
import { studio } from '../data/studio';
import type { Lang } from '../i18n/ui';
import { localizePath, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const games = await getGames(lang);
const featured = games.find((g) => g.data.featured);
const others = games.filter((g) => g !== featured);
---

<BaseLayout lang={lang}>
  <section class="hero">
    <BlackHole />
    <div class="container hero-content">
      <span class="eyebrow">{t('hero.kicker')}</span>
      <h1 set:html={t('hero.title')} />
      <p>{t('hero.text')}</p>
      <div class="actions">
        <a class="btn btn-primary" href={localizePath('/games', lang)}>{t('hero.cta.games')}</a>
        <a class="btn" href={localizePath('/about', lang)}>{t('hero.cta.about')}</a>
      </div>
    </div>
    <div class="scroll-hint" aria-hidden="true"><span></span></div>
  </section>

  {
    featured && (
      <section class="section featured">
        <div class="container">
          <span class="eyebrow">{t('home.featured')}</span>
          <div class="featured-card">
            <a class="featured-cover" href={localizePath(`/games/${featured.slug}`, lang)} tabindex="-1">
              <img src={featured.data.cover} alt="" width="1920" height="1080" />
            </a>
            <div class="featured-body">
              <span class="badge" data-status={featured.data.status}>
                {t(`status.${featured.data.status}` as const)}
                {featured.data.releaseDate && ` · ${featured.data.releaseDate}`}
              </span>
              <h2>
                <a href={localizePath(`/games/${featured.slug}`, lang)}>{featured.data.title}</a>
              </h2>
              <p class="lead">{featured.data.tagline}</p>
              {featured.data.features.length > 0 && (
                <ul class="features">
                  {featured.data.features.slice(0, 3).map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
              )}
              <div class="actions">
                {featured.data.stores.slice(0, 1).map((store) => (
                  <a class="btn btn-primary" href={store.url} target="_blank" rel="noopener noreferrer">
                    {store.name}
                  </a>
                ))}
                <a class="btn" href={localizePath(`/games/${featured.slug}`, lang)}>
                  {featured.data.title} →
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {
    others.length > 0 && (
      <section class="section games">
        <div class="container">
          <div class="section-head">
            <h2 class="section-title">{t('home.allGames')}</h2>
            <a class="more" href={localizePath('/games', lang)}>
              {t('nav.games')} →
            </a>
          </div>
          <div class="grid">
            {others.map((game) => (
              <GameCard game={game} lang={lang} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section about">
    <div class="container about-inner">
      <div class="orbit" aria-hidden="true"></div>
      <div>
        <span class="eyebrow" lang="en">{studio.fullName}</span>
        <h2 class="section-title">{t('home.aboutTitle')}</h2>
        <p class="lead">{t('home.aboutText')}</p>
        <a class="btn" href={localizePath('/about', lang)}>{t('home.aboutLink')}</a>
      </div>
    </div>
  </section>

  <section class="section contact">
    <div class="container contact-inner card">
      <div>
        <h2>{t('home.contactTitle')}</h2>
        <p class="lead">{t('home.contactText')}</p>
      </div>
      <a class="btn btn-primary" href={localizePath('/contact', lang)}>{t('nav.contact')}</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 30%;
    background: linear-gradient(transparent, var(--bg));
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding-top: var(--header-h);
  }

  .hero-content > * {
    max-width: 600px;
  }

  .hero h1 {
    margin-top: 18px;
    font-size: clamp(2.75rem, 7.5vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .hero h1 :global(em) {
    font-style: normal;
    background: linear-gradient(100deg, var(--accent-soft), var(--accent) 60%, #ff5e3a);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero p {
    margin-top: 22px;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    color: var(--text-muted);
    max-width: 480px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 28px;
    z-index: 1;
    width: 24px;
    height: 38px;
    translate: -50% 0;
    border: 1.5px solid var(--border-strong);
    border-radius: 12px;
  }

  .scroll-hint span {
    position: absolute;
    left: 50%;
    top: 8px;
    width: 3px;
    height: 7px;
    translate: -50% 0;
    border-radius: 2px;
    background: var(--text-muted);
    animation: scroll 1.8s infinite;
  }

  @keyframes scroll {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (max-width: 820px) {
    .hero {
      align-items: flex-end;
      padding-bottom: 96px;
    }
    .hero-content {
      padding-top: 52svh;
    }
  }

  /* ---------- featured ---------- */
  .featured {
    padding-top: clamp(24px, 4vw, 48px);
  }

  .featured-card {
    margin-top: 18px;
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }

  .featured-cover {
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: 0 40px 100px -40px var(--accent-glow);
  }

  .featured-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s;
  }

  .featured-cover:hover img {
    transform: scale(1.03);
  }

  .featured-body h2 {
    margin-top: 16px;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
  }

  .featured-body h2 a {
    text-decoration: none;
  }

  .featured-body .lead {
    margin-top: 14px;
  }

  .features {
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .features li {
    display: flex;
    gap: 12px;
  }

  .features li::before {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: 0.6em;
    border-radius: 50%;
    border: 1.5px solid var(--accent);
  }

  @media (max-width: 900px) {
    .featured-card {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- games ---------- */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 24px;
  }

  .more {
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .more:hover {
    color: var(--accent);
  }

  /* ---------- about ---------- */
  .about {
    border-top: 1px solid var(--border);
  }

  .about-inner {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }

  .about-inner .section-title {
    margin-top: 12px;
  }

  .about-inner .lead {
    margin-top: 18px;
    max-width: 56ch;
  }

  .about-inner .btn {
    margin-top: 28px;
  }

  .orbit {
    position: relative;
    aspect-ratio: 1;
    max-width: 380px;
    width: 100%;
    margin-inline: auto;
    border-radius: 50%;
    border: 1px solid var(--border);
    background:
      radial-gradient(circle, #000 0 22%, transparent 22.5%),
      radial-gradient(circle, rgba(255, 190, 120, 0.9) 0 23%, rgba(255, 130, 60, 0.25) 26%, transparent 40%);
  }

  .orbit::before,
  .orbit::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    border: 1px dashed rgba(255, 255, 255, 0.12);
    animation: spin 60s linear infinite;
  }

  .orbit::before {
    inset: 16%;
  }

  .orbit::after {
    inset: -10%;
    animation-duration: 120s;
    animation-direction: reverse;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 820px) {
    .about-inner {
      grid-template-columns: 1fr;
    }
    .orbit {
      max-width: 220px;
    }
  }

  /* ---------- contact ---------- */
  .contact {
    padding-top: 0;
  }

  .contact-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    padding: clamp(28px, 5vw, 56px);
    background:
      radial-gradient(120% 140% at 100% 0%, rgba(255, 138, 61, 0.14), transparent 55%),
      var(--surface);
  }

  .contact-inner h2 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  .contact-inner .lead {
    margin-top: 8px;
  }
</style>
